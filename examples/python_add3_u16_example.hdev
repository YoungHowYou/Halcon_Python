<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.2" halcon_version="24.11.1.0">
<procedure name="main">
<interface/>
<body>
<c>* ============================================================</c>
<c>* HALCON Python Extension — add3_u16 example (new dict-based API)</c>
<c>*</c>
<c>* Uses Py_SetPythonObject / Py_GetPythonObject / Py_SetPythonTuple</c>
<c>* to demonstrate the single-key dict-based data exchange.</c>
<c>*</c>
<c>* 1. Load 3 gray images, resize to same dimensions.</c>
<c>* 2. Start Python, load add3_u16.py.</c>
<c>* 3. Push 3 images via Py_SetPythonObject (iconic + dict + key).</c>
<c>* 4. Call the algorithm — uint16 sum.</c>
<c>* 5. Retrieve result via Py_GetPythonObject.</c>
<c>* ============================================================</c>
<c></c>
<l>dev_get_window (WindowHandle)</l>
<c></c>
<c>* --- 1. Load 3 test images (gray, same size) ---</c>
<l>read_image (I1, 'fabrik')</l>
<l>read_image (I2, 'mreut')</l>
<l>read_image (I3, 'monkey')</l>
<l>rgb1_to_gray (I1, G1)</l>
<l>rgb1_to_gray (I2, G2)</l>
<l>rgb1_to_gray (I3, G3)</l>
<l>get_image_size (G1, W, H)</l>
<l>zoom_image_size (G2, G2, W, H, 'constant')</l>
<l>zoom_image_size (G3, G3, W, H, 'constant')</l>
<c></c>
<c>* --- 2. Start Python and load the .py module ---</c>
<l>Py_Initialize ()</l>
<l>Py_EvalString ('import numpy as np')</l>
<l>PyFile := 'D:/Desktop/Source/Halcon_Extension/Halcon_Python/add3_u16.py'</l>
<l>Py_EvalString ('exec(open(r\'' + PyFile + '\').read())')</l>
<l>Py_GetOutput (1024, _Msg)</l>
<c></c>
<c>* --- 3. Create a shared dict and push 3 images ---</c>
<l>create_dict (Dict)</l>
<l>Py_SetPythonObject (G1, Dict, 'img1')</l>
<l>Py_SetPythonObject (G2, Dict, 'img2')</l>
<l>Py_SetPythonObject (G3, Dict, 'img3')</l>
<c></c>
<c>* --- 4. Call the algorithm — uint16 sum of 3 images ---</c>
<l>Py_EvalString ('result = add3_u16(img1, img2, img3)')</l>
<l>Py_GetOutput (1024, _Msg2)</l>
<c></c>
<c>* --- 5. Retrieve the result image ---</c>
<l>Py_GetPythonObject (SumImage, Dict, 'result')</l>
<c></c>
<c>* --- 6. Display ---</c>
<l>dev_display (SumImage)</l>
<l>dev_disp_text ('add3_u16: uint16 sum of 3 images', 'window', 'top', 'left', 'white', [], [])</l>
<l>stop ()</l>
<c></c>
<c>* --- 7. Show that the dict also contains all exchanged data ---</c>
<l>get_dict_object (DictImg1, Dict, 'img1')</l>
<l>get_dict_object (DictImg2, Dict, 'img2')</l>
<l>get_dict_object (DictImg3, Dict, 'img3')</l>
<l>get_dict_object (DictResult, Dict, 'result')</l>
<c></c>
<l>dev_display (DictResult)</l>
<l>dev_disp_text ('Same image from dict', 'window', 'top', 'left', 'white', [], [])</l>
<l>stop ()</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
